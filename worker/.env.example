# Python scoring worker — no Postgres access by design (Go is the only DB writer).
REDIS_URL=redis://localhost:6379
LANGUAGETOOL_URL=http://localhost:8010

# OpenAI-compatible endpoint. Swap provider by changing these three only.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0

# Local embedding model — fixed regardless of LLM provider (see docs/SCORING.md).
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
